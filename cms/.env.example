# Datenbank (Mittwald: PostgreSQL-Container im selben Projekt)
DATABASE_URL=postgres://payload:PASSWORT@postgres:5432/nothhelfer
# Langes Zufallspasswort, z. B. mit: openssl rand -hex 32
PAYLOAD_SECRET=
# Ordner für hochgeladene Bilder (im Container: Volume /data/media)
MEDIA_DIR=/data/media
# Nur diese Adresse kann den ersten Zugang anlegen und wird automatisch Admin
ADMIN_EMAIL=weihs@artwork-station.de
# Adresse des CMS und der Website
PAYLOAD_PUBLIC_SERVER_URL=https://cms.immobilien-nothhelfer.de
SITE_URL=https://www.immobilien-nothhelfer.de
# Weitere erlaubte Adressen, z. B. Testdomain (kommagetrennt)
EXTRA_ORIGINS=
# Website automatisch neu bauen nach dem Veröffentlichen
GITHUB_REPO=artworkstation/nothhelfer-website
GITHUB_DISPATCH_TOKEN=
# E-Mail-Versand der Formulare (Mittwald-Postfach)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=website@immobilien-nothhelfer.de
