---
import mask from '../../assets/frag_mask.txt?raw'
import glyph from '../../assets/frag_glyph.txt?raw'
import Img from '../Img.astro'
import { ICON } from '../../lib/icons'
import { bildUrl, href } from '../../lib/cms'
const { b } = Astro.props
const bg = bildUrl(b.bild)
const k = b.kacheln || []
---
<section class="hero" id="hero">
  <div class="bg" id="heroBg" style={bg ? `--hero-bild:url('${bg}')` : undefined}></div>
  <div class="dusk" id="dusk"></div>
  <div class="dusk2" id="dusk2"></div>
  <div class="copy" id="heroCopy">
    <h1><span class="ln"><span>{b.headline}</span></span></h1>
    {(b.subline || b.sublineAkzent) && <p class="sub"><span class="ln"><span>{b.subline} {b.sublineAkzent && <em>{b.sublineAkzent}</em>}</span></span></p>}
    {k.length > 0 && <div class="mcta">{k.map((t: any, i: number) => <a class={i === 0 ? 'p' : 's'} href={href(t.link)}>{t.text.replace(/\n/g, ' ')}{i === 0 && <Fragment set:html={ICON.arrow} />}</a>)}</div>}
  </div>
  <div class="cloud" id="cloud"></div>
  {k.length > 0 && <div class="tiles" id="tiles">{k.map((t: any) => <a href={href(t.link)} class="tile"><Img m={t.bild} alt="" sizes="220px" /><span set:html={t.text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/\n/g, '<br>')} /></a>)}</div>}
  <div class="sign" id="sign" aria-hidden="true">
    <svg viewBox="95 245 690 190">
      <defs><mask id="penmask" maskUnits="userSpaceOnUse" x="0" y="150" width="900" height="400" set:html={mask} /></defs>
      <g mask="url(#penmask)" fill="#fff" set:html={glyph} />
    </svg>
    {b.claim && <p class="claim" id="claim">{b.claim}</p>}
  </div>
  <div class="fog" id="fog"></div>
  <div class="scrollhint" id="hint"></div>
</section>
