---
import { bildUrl, href } from '../../lib/cms'
import { ICON } from '../../lib/icons'
const { b } = Astro.props
const bg = bildUrl(b.bild)
---
<section class="cta">
  <div class="bg" style={bg ? `--cta-bild:url('${bg}')` : undefined}></div>
  <div class="in">
    <h2>{b.zeile1 && <span class="ln"><span>{b.zeile1}</span></span>}{b.zeile2 && <span class="ln"><span>{b.zeile2}</span></span>}</h2>
    {b.text && <p class="fadeup">{b.text}</p>}
    {b.buttons?.length > 0 && <div class="btns fadeup">{b.buttons.map((x: any) => <a href={href(x.link)} class="btn light">{x.text} <Fragment set:html={ICON.arrow} /></a>)}</div>}
  </div>
</section>
