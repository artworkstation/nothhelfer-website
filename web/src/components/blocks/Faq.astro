---
const { b } = Astro.props
---
<section class="sec"><div class="wrap grid2">
  <div>{b.label && <span class="label">{b.label}</span>}<h2>{b.zeile1 && <span class="ln"><span>{b.zeile1}</span></span>}{b.zeile2 && <span class="ln"><span class="blue">{b.zeile2}</span></span>}</h2></div>
  <div class="faq fadeup">{(b.fragen || []).map((f: any) => <details><summary>{f.frage}</summary><p>{f.antwort}</p></details>)}</div>
</div></section>
