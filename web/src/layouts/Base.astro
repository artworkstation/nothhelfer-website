---
import '@fontsource/roboto/300.css'
import '@fontsource/roboto/400.css'
import '@fontsource/roboto/500.css'
import '@fontsource/roboto/700.css'
import '../styles/site.css'
import Logo from '../components/Logo.astro'
import { ICON } from '../lib/icons'
import { getEinstellungen, getGemeinden, getNavigation, href, tel, bildUrl } from '../lib/cms'

interface Props {
  title: string
  description?: string
  home?: boolean
  ogImage?: any
  noindex?: boolean
  jsonld?: any[]
}
const { title, description, home = false, ogImage, noindex = false, jsonld = [] } = Astro.props
const e = await getEinstellungen()
const nav = (await getNavigation()).hauptmenue || []
const gemeinden = (await getGemeinden()).slice(0, 4)
const telHref = tel(e.telefon)
const cur = '/' + (Astro.url.pathname.split('/')[1] || '') + '/'
const canonical = new URL(Astro.url.pathname, Astro.site).href
const og = bildUrl(ogImage)

const org = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateAgent',
  name: e.firma,
  founder: e.inhaber,
  url: Astro.site?.href,
  telephone: '+49 ' + String(e.telefon).replace(/^0/, ''),
  faxNumber: e.fax ? '+49 ' + String(e.fax).replace(/^0/, '') : undefined,
  email: e.email,
  address: { '@type': 'PostalAddress', streetAddress: e.strasse, postalCode: e.plz, addressLocality: e.ort, addressCountry: 'DE' },
  geo: { '@type': 'GeoCoordinates', latitude: e.lat, longitude: e.lng },
  areaServed: [{ '@type': 'GeoCircle', geoMidpoint: { '@type': 'GeoCoordinates', latitude: e.lat, longitude: e.lng }, geoRadius: 40000 }],
  memberOf: [{ '@type': 'Organization', name: 'Immobilienverband Deutschland IVD' }],
  sameAs: (e.social || []).map((s: any) => s.url),
}
const ld = [...(home ? [org] : []), ...jsonld]
const badges = [
  ['/img/badge-ivd.svg', 'IVD Mitglied'],
  ['/img/badge-din.jpg', 'Zertifiziert nach DIN EN 15733'],
  ['/img/badge-hg.png', 'Haus & Grund Immobilien-Verbund'],
]
const isCur = (l: string) => href(l).split('/')[1] === cur.split('/')[1]
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="de_DE" />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:url" content={canonical} />
  {og && <meta property="og:image" content={og} />}
  <meta name="theme-color" content="#302f77" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  {ld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
</head>
<body class={home ? 'home' : 'sub'}>
  <a class="skip" href="#inhalt">Zum Inhalt springen</a>
  <header class="hdr" id="hdr"><div class="in">
    <a href="/" class="logo" aria-label="Immobilien Nothhelfer – Startseite"><Logo /></a>
    <nav class="nav" aria-label="Hauptnavigation">
      {nav.map((n: any) => n.unterpunkte?.length ? (
        <span class="dd"><a href={href(n.link)} class={isCur(n.link) ? 'cur' : undefined}>{n.text}</a><span class="menu">{n.unterpunkte.map((u: any) => <a href={href(u.link)}>{u.text}</a>)}</span></span>
      ) : (
        <a href={href(n.link)} class={isCur(n.link) ? 'cur' : undefined}>{n.text}</a>
      ))}
    </nav>
    <a href={telHref} title={e.telefon} class="phone" aria-label="Anrufen" set:html={ICON.phone} />
    <div class="badges">{badges.map(([s, a]) => <span class="badge"><img src={s} alt={a} /></span>)}</div>
    <button class="burger" id="burger" aria-label="Menü öffnen" aria-expanded="false" aria-controls="mmenu"><svg width="28" height="16" viewBox="0 0 28 16" stroke="#3f4a52" stroke-width="1.6"><path d="M0 3h28M0 13h28" /></svg></button>
  </div></header>
  <div class="mmenu" id="mmenu" role="dialog" aria-label="Menü">
    <div class="top"><a href="/" class="logo"><Logo /></a><button class="mclose" id="mclose" aria-label="Menü schließen"><svg width="22" height="22" viewBox="0 0 22 22" stroke="#3f4a52" stroke-width="1.6"><path d="M2 2l18 18M20 2L2 20" /></svg></button></div>
    <ul class="mlist">
      {nav.map((n: any) => n.unterpunkte?.length ? (
        <li><button class="mi">{n.text} <Fragment set:html={ICON.chev} /></button><ul class="msub">{n.unterpunkte.map((u: any) => <li><a href={href(u.link)}>{u.text}</a></li>)}</ul></li>
      ) : (
        <li><a class="mi" href={href(n.link)}>{n.text}</a></li>
      ))}
    </ul>
    <a class="mcall" href={telHref}><Fragment set:html={ICON.phone} /> Jetzt anrufen</a>
    <p class="maddr">{e.strasse} · {e.plz} {e.ort} · {e.telefon}</p>
  </div>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <div id="inhalt"><slot /></div>

  <footer class="ftr"><div class="wrap"><div class="g">
    <div><div class="logo"><Logo text="#fff" schrift="#fff" /></div>
      <p>{e.firma}<br />{e.strasse}<br />{e.plz} {e.ort}</p>
      <p style="margin-top:12px">Tel. <a href={telHref}>{e.telefon}</a>{e.fax && <><br />Fax {e.fax}</>}<br /><a href={`mailto:${e.email}`}>{e.email}</a></p>
      <div class="bdg">{badges.map(([s, a]) => <span><img src={s} alt={a} loading="lazy" /></span>)}</div>
    </div>
    <div><h4>Immobilien</h4><ul><li><a href="/immobilien/">Aktuelle Angebote</a></li><li><a href="/immobilien/kaufen/">Kaufen</a></li><li><a href="/immobilien/mieten/">Mieten</a></li><li><a href="/immobilien/suchauftrag/">Suchauftrag anlegen</a></li><li><a href="/verkaufen/">Immobilie verkaufen</a></li><li><a href="/verkaufen/online-wertermittlung/">Online-Wertermittlung</a></li></ul></div>
    <div><h4>Nothhelfer</h4><ul><li><a href="/ueber-uns/">Unternehmen &amp; Team</a></li><li><a href="/ueber-uns/erik-nothhelfer/">{e.inhaber}</a></li><li><a href="/gutachten/">Gutachten &amp; Bewertung</a></li><li><a href="/ueber-uns/referenzen/">Referenzen</a></li><li><a href="/ueber-uns/kundenstimmen/">Kundenstimmen</a></li><li><a href="/ratgeber/">Ratgeber</a></li></ul></div>
    <div><h4>Region</h4><ul><li><a href="/region/ulm-neu-ulm/">Ulm &amp; Neu-Ulm</a></li><li><a href="/region/alb-donau-kreis/">Alb-Donau-Kreis</a></li>{gemeinden.map((g: any) => <li><a href={`/immobilienmakler-${g.slug}/`}>Immobilienmakler {g.name}</a></li>)}</ul>
      <h4 style="margin-top:24px">Termine</h4><p>{e.termine}</p>{e.claimFooter && <p>{e.claimFooter}</p>}</div>
  </div><div class="bot"><span>© {new Date().getFullYear()} Immobilien Nothhelfer</span><span><a href="/impressum/">Impressum</a> · <a href="/datenschutz/">Datenschutz</a> · <a href="/agb/">AGB</a></span></div></div></footer>

  <script>
    import '../scripts/site'
    import '../scripts/home'
  </script>
</body>
</html>
