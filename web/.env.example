# Adresse des CMS (Payload). Beim Build werden alle Inhalte von hier geladen.
CMS_URL=http://localhost:3000
# Öffentliche Adresse des CMS – für Formulare im Browser (meist identisch mit CMS_URL)
PUBLIC_CMS_URL=http://localhost:3000
# Adresse der fertigen Website (für Sitemap, Canonical, Social-Media-Vorschau)
SITE_URL=http://localhost:4321
